# Server-only settings for the local catalog intermediary (server/index.js).
# Copy to .env and fill in. Never prefix these with VITE_ and never commit .env.
ODOO_URL=https://sys-go.com
ODOO_DB=mylabo
# Dedicated least-privilege integration user (not the administrator).
ODOO_USERNAME=YOUR_ODOO_INTEGRATION_USER
# Prefer an Odoo API key generated for that user (Preferences > Account Security).
ODOO_PASSWORD=YOUR_PRIVATE_CREDENTIAL

# Only sellable products carrying this Odoo product tag are shown on the storefront.
ODOO_STOREFRONT_TAG=Storefront

# Optional
# API_PORT=8787
# ODOO_TIMEOUT_MS=15000
