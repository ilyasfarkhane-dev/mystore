# Production environment for the catalog intermediary on the VPS.
# Install as /etc/maison/catalog-api.env (owner root, mode 600). Never commit the real file.
NODE_ENV=production
ODOO_URL=https://sys-go.com
ODOO_DB=mylabo
ODOO_USERNAME=YOUR_ODOO_INTEGRATION_USER
ODOO_PASSWORD=YOUR_PRIVATE_CREDENTIAL
ODOO_STOREFRONT_TAG=Storefront

API_HOST=127.0.0.1
API_PORT=8787
# Public hostname Nginx forwards in the Host header.
API_ALLOWED_HOSTS=shop.example.com
# Use X-Real-IP set by Nginx for rate limiting.
TRUST_PROXY=1
API_RATE_LIMIT_PER_MINUTE=300
